# Application Configuration
PORT=4000
NODE_ENV=development

# Database Settings (PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/trustzone_db?schema=public"
# DIRECT_URL="postgresql://postgres:your_db_password@localhost:5432/trustzone_db?schema=public" # Optional direct URL for connection poolers (e.g. PgBouncer)

# Redis Caching Settings
# REDIS_URL="redis://default:password@localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Authentication Secrets
JWT_SECRET_KEY="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET_KEY="your-jwt-refresh-secret-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Gateways (Stripe API)
STRIPE_API_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# External Notification Adapters (Twilio / SendGrid APIs)
TWILIO_ACCOUNT_SID="AC_placeholder"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_placeholder"
TWILIO_PHONE_NUMBER="+10000000000"

SENDGRID_API_KEY="SG_placeholder"
SENDGRID_FROM_EMAIL="noreply@example.com"

# Rate Limiting & Throttler
THROTTLER_TTL=60000
THROTTLER_LIMIT=60
