# Application Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Database Settings (PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/trustzone_db?schema=public"

# Redis Caching Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication Secrets
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_SECRET_KEY="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-change-in-production"
JWT_REFRESH_SECRET_KEY="your-jwt-refresh-secret-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Gateways (SSLCommerz / AmarPay / Stripe)
SSLCOMMERZ_STORE_ID="store_id_placeholder"
SSLCOMMERZ_STORE_PASSWORD="store_password_placeholder"
AMARPAY_STORE_ID="amarpay_store_placeholder"
AMARPAY_SIGNATURE_KEY="amarpay_signature_placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_API_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Communication & Notification Gateways
BULKSMS_API_KEY="bulksms_api_key_placeholder"
WHATSAPP_API_KEY="whatsapp_api_key_placeholder"
FCM_SERVER_KEY="fcm_server_key_placeholder"
TWILIO_ACCOUNT_SID="AC_placeholder"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_placeholder"
TWILIO_PHONE_NUMBER="+10000000000"
SENDGRID_API_KEY="SG_placeholder"
SENDGRID_FROM_EMAIL="noreply@trustzone.care"

# Rate Limiting & Throttler
THROTTLER_TTL=60000
THROTTLER_LIMIT=60
