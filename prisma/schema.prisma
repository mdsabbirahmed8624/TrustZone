datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Branch {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  code              String?           @unique
  address           String
  district          String?
  thana             String?
  mapUrl            String?
  phone             String?
  email             String?
  openingHours      String?
  timezone          String            @default("Asia/Dhaka")
  status            String            @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE
  logo              String?
  images            String[]          @default([])
  description       String?
  managerId         String?           @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  users             User[]
  tickets           Ticket[]
  branchInventory   BranchInventory[]
  stockMovements    StockMovement[]
  customers         Customer[]
  invoices          Invoice[]
  purchaseOrders    PurchaseOrder[]
  transfersSent     StockTransfer[]   @relation("FromBranch")
  transfersReceived StockTransfer[]   @relation("ToBranch")
  branchTransfersFrom BranchTransfer[] @relation("BranchTransferFrom")
  branchTransfersTo   BranchTransfer[] @relation("BranchTransferTo")
  financialAccounts FinancialAccount[]
  journalEntries    JournalEntry[]
  expenses          Expense[]
  incomes           Income[]
  dailyClosings     DailyClosing[]
  warranties        Warranty[]
  warrantyClaims    WarrantyClaim[]
  supplierRmas      SupplierRma[]
  warehouses        Warehouse[]
  purchaseRequests  PurchaseRequest[]
  assets            Asset[]

  @@map("branches")
}

model BranchTransfer {
  id            String   @id @default(uuid()) @db.Uuid
  transferType  String   @default("INVENTORY") // INVENTORY, TICKET, CUSTOMER, TECHNICIAN
  fromBranchId  String   @db.Uuid
  fromBranch    Branch   @relation("BranchTransferFrom", fields: [fromBranchId], references: [id])
  toBranchId    String   @db.Uuid
  toBranch      Branch   @relation("BranchTransferTo", fields: [toBranchId], references: [id])
  entityId      String?
  entityName    String?
  quantity      Int      @default(1)
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  notes         String?
  requestedById String?  @db.Uuid
  approvedById  String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("branch_transfers")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("roles")
}

model User {
  id                       String          @id @default(uuid()) @db.Uuid
  email                    String          @unique
  password                 String
  firstName                String
  lastName                 String
  role                     String
  roleId                   String?         @db.Uuid
  roleRelation             Role?           @relation(fields: [roleId], references: [id])
  branchId                 String?         @db.Uuid
  branch                   Branch?         @relation(fields: [branchId], references: [id])
  tickets                  Ticket[]        @relation("AssignedTech")
  ticketHistory            TicketHistory[]
  failedLoginAttempts      Int             @default(0)
  lockoutUntil             DateTime?
  isEmailVerified          Boolean         @default(false)
  emailVerificationToken   String?         @unique
  emailVerificationExpires DateTime?
  passwordResetToken       String?         @unique
  passwordResetExpires     DateTime?
  sessions                 Session[]
  auditLogs                AuditLog[]
  devices                  UserDevice[]
  skills                   String[]        @default([])
  availability             Boolean         @default(true)
  leaveStatus              String          @default("active")
  isOnline                 Boolean         @default(false)
  gpsLatitude              Float?
  gpsLongitude             Float?
  certificationLevel       String          @default("L1")
  rating                   Float           @default(5.0)
  attendances              Attendance[]
  leaveRequests            LeaveRequest[]
  createdAt                DateTime        @default(now())
  
  journalEntries           JournalEntry[]
  expensesCreated          Expense[]       @relation("ExpenseCreatedBy")
  expensesApproved         Expense[]       @relation("ExpenseApprovedBy")
  incomes                  Income[]
  transfers                AccountTransfer[]
  adjustments              AccountAdjustment[]
  dailyClosings            DailyClosing[]

  notifications            Notification[]  @relation("UserNotifications")
  assignedTasks            Task[]          @relation("AssignedTasks")
  taskComments             TaskComment[]
  sentChatMessages         ChatMessage[]   @relation("SentChatMessages")
  receivedChatMessages     ChatMessage[]   @relation("ReceivedChatMessages")
  dashboardWidgets         DashboardWidget[]
  notificationPreference   UserNotificationPreference?
  exportJobs               ExportJob[]
  employeeProfile          EmployeeProfile?
  leaveBalances            LeaveBalance[]
  payrollStructure         PayrollStructure?
  payslips                 Payslip[]
  performanceReviews       PerformanceReview[]
  reportingToId            String?             @db.Uuid
  reportingTo              User?               @relation("ReportingHierarchy", fields: [reportingToId], references: [id], onDelete: SetNull)
  subordinates             User[]              @relation("ReportingHierarchy")
  
  employeeAssets           EmployeeAsset[]
  goals                    GoalOKR[]
  
  sessionLogs              SessionLog[]
  customFormSubmissions    CustomFormSubmission[]
  savedReports             SavedReport[]
  savedDashboards          SavedDashboard[]

  deviceDiagnostics        DeviceDiagnostic[]
  technicianTelemetries     TechnicianTelemetry[]

  inventoryReservations    InventoryReservation[]
  inventoryAdjustments     InventoryAdjustment[] @relation("ApprovedAdjustments")
  purchaseReceivings       PurchaseReceiving[]
  technicianInventories    TechnicianInventory[]
  inventoryAuditLogs       InventoryAuditLog[]
  inventoryMovements       InventoryMovement[]

  requestedPurchaseRequests PurchaseRequest[]   @relation("RequestedPurchaseRequests")
  managerApprovedRequests   PurchaseRequest[]   @relation("ManagerApprovedRequests")
  procurementApprovedRequests PurchaseRequest[] @relation("ProcurementApprovedRequests")
  financeApprovedRequests   PurchaseRequest[]   @relation("FinanceApprovedRequests")
  purchaseOrderApprovals   PurchaseOrderApproval[]
  reportHistories          ReportHistory[]
  knowledgeSearches        KnowledgeSearch[]
  aiAuditLogs              AIAuditLog[]
  apiClients               ApiClient[]
  webhookEndpoints         WebhookEndpoint[]
  integrationLogs          IntegrationLog[]
  idempotencyKeys          IdempotencyKey[]
  workflowExecutions       WorkflowExecution[]
  approvalRequests         ApprovalRequest[]   @relation("RequesterApprovals")
  approvedRequests         ApprovalRequest[]   @relation("ApproverApprovals")
  reminders                Reminder[]
  ownedDocuments           Document[]          @relation("DocumentOwner")
  documentShares           DocumentShare[]
  documentAudits           DocumentAudit[]
  identityProfile          IdentityProfile?
  authSessions             AuthSession[]
  trustedDevices           TrustedDevice[]
  loginAudits              LoginAudit[]
  passwordHistories        PasswordHistory[]
  securityEvents           SecurityEvent[]
  roleAssignments          RoleAssignment[]
  mfaConfig                MFAConfiguration?
  assignedLeads            Lead[]              @relation("LeadAssignedUser")
  assignedOpportunities    Opportunity[]       @relation("OpportunityAssignedUser")
  createdCampaigns         Campaign[]          @relation("CampaignCreatedUser")
  employmentHistories      EmploymentHistory[]
  employeeDocuments        EmployeeDocument[]
  attendanceCorrections    AttendanceCorrection[]
  payrollItems             PayrollItem[]
  salaryStructure          SalaryStructure?
  bonuses                  Bonus[]
  employeeGoals            EmployeeGoal[]
  warningLetters           WarningLetter[]
  rewards                  Reward[]
  assignedSupportTickets   SupportTicket[]     @relation("SupportTicketAssignedUser")
  assetAssignments         AssetAssignment[]

  isDeleted                Boolean             @default(false)
  deletedAt                DateTime?

  @@map("users")
}

model Customer {
  id                               String                  @id @default(uuid()) @db.Uuid
  firstName                        String
  lastName                         String
  email                            String                  @unique
  phone                            String
  loyaltyPoints                    Int                     @default(0)
  tags                             String[]                @default([]) // VIP, Regular, Corporate, Dealer, Warranty, Walk-In, Blacklisted
  branchId                         String?                 @db.Uuid
  branch                           Branch?                 @relation(fields: [branchId], references: [id])
  preferredLanguage                String                  @default("English")
  preferredContactTime             String?
  preferredCommunicationChannel    String                  @default("Email")
  marketingOptIn                   Boolean                 @default(true)
  doNotDisturb                     Boolean                 @default(false)
  notes                            String?
  createdAt                        DateTime                @default(now())
  devices                          Device[]
  tickets                          Ticket[]
  communications                   CustomerCommunication[]
  documents                        CustomerDocument[]
  dueBalance                       Decimal                 @default(0.00) @db.Decimal(10, 2)
  journalLines                     JournalLine[]
  loyaltyTransactions              LoyaltyTransaction[]
  feedbacks                        CustomerFeedback[]
  activities                       CustomerActivity[]
  warranties                       Warranty[]
  customerInsights                 CustomerInsight[]
  opportunities                    Opportunity[]
  customerJourneys                 CustomerJourney[]
  customerTouchpoints              CustomerTouchpoint[]
  communicationHistories           CommunicationHistory[]
  followUpReminders                FollowUpReminder[]
  supportTickets                   SupportTicket[]
  customerComplaints               CustomerComplaint[]
  satisfactionSurveys              SatisfactionSurvey[]
  crmNotes                         CRMNote[]

  isDeleted                        Boolean                 @default(false)
  deletedAt                        DateTime?

  @@map("customers")
}

model Device {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @db.Uuid
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  brand        String
  model        String
  serialNumber String?
  imei         String?
  createdAt    DateTime @default(now())
  tickets      Ticket[]

  @@map("devices")
}

model Ticket {
  id             String          @id @default(uuid()) @db.Uuid
  branchId       String          @db.Uuid
  branch         Branch          @relation(fields: [branchId], references: [id])
  customerId     String          @db.Uuid
  customer       Customer        @relation(fields: [customerId], references: [id])
  deviceId       String          @db.Uuid
  device         Device          @relation(fields: [deviceId], references: [id])
  assignedTechId String?         @db.Uuid
  assignedTech   User?           @relation("AssignedTech", fields: [assignedTechId], references: [id])
  status                 String          @default("booked")
  estimatedCost          Decimal         @default(0.00) @db.Decimal(10, 2)
  slaDeadline            DateTime
  diagnosisNotes         String?
  internalNotes          String?
  faults                 String[]        @default([])
  tests                  String[]        @default([])
  photos                 String[]        @default([])
  partsRequired          String[]        @default([])
  customerApproved       Boolean         @default(false)
  diagnosticCompletedAt  DateTime?
  repairedAt             DateTime?
  deliveredAt            DateTime?
  createdAt              DateTime        @default(now())
  ticketHistory          TicketHistory[]
  stockMovements         StockMovement[]
  invoice                Invoice?
  feedback               CustomerFeedback?
  warranty               Warranty?

  deviceDiagnostics      DeviceDiagnostic[]
  technicianTelemetries   TechnicianTelemetry[]

  workOrderSignatures    WorkOrderSignature[]
  mobilePaymentLogs      MobilePaymentLog[]

  inventoryReservations  InventoryReservation[]
  repairPredictions      RepairPrediction[]
  
  isDeleted              Boolean          @default(false)
  deletedAt              DateTime?

  @@map("tickets")
}

model TicketHistory {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  oldStatus   String
  newStatus   String
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  notes       String?
  createdAt   DateTime @default(now())

  @@map("ticket_histories")
}

model Part {
  id                  String            @id @default(uuid()) @db.Uuid
  sku                 String            @unique
  name                String
  category            String            @default("General")
  brand               String            @default("Generic")
  brandCompatibility  String
  modelCompatibility  String[]
  basePrice           Decimal           @db.Decimal(10, 2)
  minimumStockBuffer  Int               @default(5)
  supplierId          String?           @db.Uuid
  supplier            Supplier?         @relation(fields: [supplierId], references: [id])
  branchInventory     BranchInventory[]
  stockMovements      StockMovement[]
  purchaseOrderItems  PurchaseOrderItem[]
  stockTransfers      StockTransfer[]
  supplierRmas        SupplierRma[]
  warrantyClaimsOld   WarrantyClaim[] @relation("OldPart")
  warrantyClaimsNew   WarrantyClaim[] @relation("NewPart")

  inventoryItems      InventoryItem[]
  technicianInventories TechnicianInventory[]
  purchaseRequests    PurchaseRequest[]
  demandForecasts     DemandForecast[]
  
  isDeleted           Boolean         @default(false)
  deletedAt           DateTime?

  @@map("parts")
}

model BranchInventory {
  branchId    String @db.Uuid
  branch      Branch @relation(fields: [branchId], references: [id])
  partId      String @db.Uuid
  part        Part   @relation(fields: [partId], references: [id])
  quantity    Int    @default(0)
  binLocation String?

  @@id([branchId, partId])
  @@map("branch_inventories")
}

model StockMovement {
  id                String   @id @default(uuid()) @db.Uuid
  branchId          String   @db.Uuid
  branch            Branch   @relation(fields: [branchId], references: [id])
  partId            String   @db.Uuid
  part              Part     @relation(fields: [partId], references: [id])
  quantityDelta     Int
  type              String
  referenceTicketId String?  @db.Uuid
  referenceTicket   Ticket?  @relation(fields: [referenceTicketId], references: [id])
  createdAt         DateTime @default(now())

  @@map("stock_movements")
}

model Invoice {
  id            String    @id @default(uuid()) @db.Uuid
  ticketId      String    @unique @db.Uuid
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  invoiceNumber String    @unique
  subtotal      Decimal   @db.Decimal(10, 2)
  tax           Decimal   @db.Decimal(10, 2)
  total         Decimal   @db.Decimal(10, 2)
  status        String    @default("unpaid")
  branchId      String?   @db.Uuid
  branch        Branch?   @relation(fields: [branchId], references: [id])
  createdAt     DateTime  @default(now())
  payments      Payment[]
  
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?

  @@map("invoices")
}

model Payment {
  id                   String            @id @default(uuid()) @db.Uuid
  invoiceId            String            @db.Uuid
  invoice              Invoice           @relation(fields: [invoiceId], references: [id])
  amount               Decimal           @db.Decimal(10, 2)
  paymentMethod        String
  transactionReference String?
  status               String
  accountId            String?           @db.Uuid
  account              FinancialAccount? @relation(fields: [accountId], references: [id])
  createdAt            DateTime          @default(now())

  @@map("payments")
}

model Session {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String   @unique
  deviceFingerprint String?
  ipAddress         String?
  userAgent         String?
  logoutAt          DateTime?
  isValid           Boolean  @default(true)
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String?
  details   String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DeviceStatus {
  ACTIVE
  BLOCKED
  LOST
  SUSPICIOUS
}

enum DeviceType {
  ANDROID
  IOS
  WEB
  DESKTOP
  TABLET
}

enum DeviceEventType {
  LOGIN
  LOGOUT
  TOKEN_REFRESH
  TRUST
  UNTRUST
  BLOCK
  UNBLOCK
  PUSH_UPDATED
  LOCATION_CHANGED
}

model UserDevice {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceUUID        String
  deviceFingerprint String
  deviceType        DeviceType     @default(ANDROID)
  status            DeviceStatus   @default(ACTIVE)
  brand             String?
  model             String?
  os                String?
  osVersion         String?
  
  // Push Notification support
  pushTokens        PushToken[]

  // Device Risk Scoring
  riskScore         Float          @default(0.0)
  riskLevel         RiskLevel      @default(LOW)
  failedLoginCount  Int            @default(0)
  lastFailedLogin   DateTime?

  // Location Metadata
  country           String?
  city              String?
  timezone          String?

  // Timestamps tracking
  lastLoginAt       DateTime?
  lastRefreshAt     DateTime?
  lastLogoutAt      DateTime?
  
  isTrusted         Boolean        @default(false)
  isAuthorized      Boolean        @default(true)
  rememberDevice    Boolean        @default(false)
  lastIpAddress     String?
  lastUserAgent     String?
  lastUsedAt        DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Audit logs
  events            DeviceEvent[]

  @@unique([userId, deviceUUID])
  @@map("user_devices")
}

model PushToken {
  id        String     @id @default(uuid()) @db.Uuid
  deviceId  String     @db.Uuid
  device    UserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  provider  String     // e.g., "FCM", "APNS", "HUAWEI"
  token     String     @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("push_tokens")
}

model DeviceEvent {
  id        String          @id @default(uuid()) @db.Uuid
  deviceId  String          @db.Uuid
  device    UserDevice      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  eventType DeviceEventType
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime        @default(now())

  @@map("device_events")
}

model CustomerCommunication {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       String   // SMS, Email, WhatsApp
  subject    String?
  message    String
  status     String   @default("Sent") // Pending, Queued, Sent, Delivered, Failed, Read
  staffId    String?  @db.Uuid
  staffName  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("customer_communications")
}

model CustomerDocument {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileSize   Int
  uploadedAt DateTime @default(now())

  @@map("customer_documents")
}

model CustomerFeedback {
  id                  String    @id @default(uuid()) @db.Uuid
  customerId          String    @db.Uuid
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ticketId            String?   @unique @db.Uuid
  ticket              Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  rating              Int?
  npsScore            Int?
  comments            String?
  channel             String?   @default("WEB_PORTAL")
  wouldRecommend      String?   // Yes, No
  followUpRequired    Boolean   @default(false)
  assignedStaffId     String?   @db.Uuid
  assignedStaffName   String?
  resolutionStatus    String    @default("PENDING") // PENDING, RESOLVED
  responseDate        DateTime?
  status              String    @default("PENDING") // PENDING, SENT, COMPLETED
  sentAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("customer_feedbacks")
}

model LoyaltyTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @db.Uuid
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pointsDelta   Int
  remainingPoints Int    @default(0)
  type          String   // EARNED, REDEEMED, ADJUSTED, EXPIRED, REVERSED
  description   String?
  referenceId   String?  @db.Uuid
  staffId       String?  @db.Uuid
  staffName     String?
  createdAt     DateTime @default(now())

  @@map("loyalty_transactions")
}

model CustomerActivity {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String   // CUSTOMER_CREATED, CUSTOMER_UPDATED, TICKET_CREATED, TICKET_STATUS_CHANGED, INVOICE_GENERATED, PAYMENT_RECEIVED, LOYALTY_EARNED, LOYALTY_REDEEMED, LOYALTY_ADJUSTED, LOYALTY_EXPIRED, SMS_SENT, EMAIL_SENT, WHATSAPP_SENT, SURVEY_SCHEDULED, SURVEY_SENT, SURVEY_COMPLETED, FEEDBACK_SUBMITTED, NOTE_ADDED, MANUAL_ACTION
  title       String
  description String?
  staffId     String?  @db.Uuid
  staffName   String?
  referenceId String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@map("customer_activities")
}

model Attendance {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                  DateTime  @db.Date
  status                String    // present, absent, late, leave, half_day, holiday, weekly_off
  checkIn               DateTime?
  checkOut              DateTime?
  breakStart            DateTime?
  breakEnd              DateTime?
  lateArrival           Boolean   @default(false)
  earlyLeave            Boolean   @default(false)
  halfDay               Boolean   @default(false)
  latitude              Float?
  longitude             Float?
  biometricVerification Boolean   @default(false)
  createdAt             DateTime  @default(now())

  @@unique([userId, date])
  @@map("attendances")
}

model LeaveRequest {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  reason          String
  status          String        @default("pending") // pending, approved, rejected
  leaveType       String        @default("CASUAL") // ANNUAL, SICK, CASUAL, EMERGENCY, UNPAID
  approvedById    String?       @db.Uuid
  rejectionReason String?
  createdAt       DateTime      @default(now())

  @@map("leave_requests")
}

model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  email          String
  phone          String
  contactPerson  String?
  address        String?
  rating         Float           @default(5.0)
  createdAt      DateTime        @default(now())
  parts          Part[]
  purchaseOrders PurchaseOrder[]
  ledger         SupplierLedger[]
  dueBalance     Decimal         @default(0.00) @db.Decimal(10, 2)
  journalLines   JournalLine[]
  supplierRmas   SupplierRma[]
  
  category       String?
  status         String          @default("ACTIVE") // ACTIVE, INACTIVE, BLACKLISTED
  documents      SupplierDocument[]

  isDeleted      Boolean         @default(false)
  deletedAt      DateTime?

  @@map("suppliers")
}

model SupplierLedger {
  id         String   @id @default(uuid()) @db.Uuid
  supplierId String   @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(10, 2)
  type       String   // CREDIT (owed to supplier) or DEBIT (paid to supplier)
  reference  String?
  createdAt  DateTime @default(now())

  @@map("supplier_ledgers")
}

model PurchaseOrder {
  id            String              @id @default(uuid()) @db.Uuid
  supplierId    String              @db.Uuid
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  status        String              @default("DRAFT") // DRAFT, APPROVED, ORDERED, RECEIVED, CANCELLED
  paymentStatus String              @default("unpaid") // unpaid, partially_paid, paid
  totalAmount   Decimal             @db.Decimal(10, 2)
  branchId      String              @db.Uuid
  branch        Branch              @relation(fields: [branchId], references: [id])
  items         PurchaseOrderItem[]
  purchaseReceivings PurchaseReceiving[]
  
  purchaseRequestId String?             @db.Uuid
  purchaseRequest   PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  
  approvals         PurchaseOrderApproval[]
  attachments       ProcurementAttachment[]

  isDeleted         Boolean             @default(false)
  deletedAt         DateTime?
  version           Int                 @default(0)
  createdAt         DateTime            @default(now())

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  partId          String        @db.Uuid
