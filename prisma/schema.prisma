model CostCenter {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique // e.g. CC-101
  name        String
  department  String?
  managerName String?
  budgetLines BudgetLine[]
  createdAt   DateTime     @default(now())

  @@map("cost_centers")
}

model Budget {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  fiscalYear  String       // e.g. "FY2026"
  department  String?
  totalBudget Decimal      @db.Decimal(12, 2)
  status      String       @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  lines       BudgetLine[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("budgets")
}

model BudgetLine {
  id           String      @id @default(uuid()) @db.Uuid
  budgetId     String      @db.Uuid
  budget       Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  costCenterId String?     @db.Uuid
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  category     String      // SALARIES, UTILITIES, EQUIPMENT, MARKETING, IT_INFRASTRUCTURE
  allocated    Decimal     @db.Decimal(12, 2)
  spent        Decimal     @default(0.00) @db.Decimal(12, 2)
  variance     Decimal     @db.Decimal(12, 2)

  @@map("budget_lines")
}

model VendorInvoice {
  id              String            @id @default(uuid()) @db.Uuid
  invoiceNo       String            @unique
  vendorName      String
  invoiceDate     DateTime          @default(now())
  dueDate         DateTime
  totalAmount     Decimal           @db.Decimal(12, 2)
  paidAmount      Decimal           @default(0.00) @db.Decimal(12, 2)
  status          String            @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE
  accountsPayable AccountsPayable[]
  createdAt       DateTime          @default(now())

  @@map("vendor_invoices")
}

model CustomerInvoice {
  id                 String               @id @default(uuid()) @db.Uuid
  invoiceNo          String               @unique
  customerName       String
  invoiceDate        DateTime             @default(now())
  dueDate            DateTime
  totalAmount        Decimal              @db.Decimal(12, 2)
  paidAmount         Decimal              @default(0.00) @db.Decimal(12, 2)
  status             String               @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE
  accountsReceivable AccountsReceivable[]
  createdAt          DateTime             @default(now())

  @@map("customer_invoices")
}

model PaymentVoucher {
  id          String   @id @default(uuid()) @db.Uuid
  voucherNo   String   @unique
  payeeName   String
  amount      Decimal  @db.Decimal(12, 2)
  paymentMode String   @default("BANK_TRANSFER") // CASH, CHEQUE, BANK_TRANSFER, EFT
  paymentDate DateTime @default(now())
  reference   String?

  @@map("payment_vouchers")
}

model ReceiptVoucher {
  id          String   @id @default(uuid()) @db.Uuid
  voucherNo   String   @unique
  payerName   String
  amount      Decimal  @db.Decimal(12, 2)
  paymentMode String   @default("BANK_TRANSFER")
  receivedDate DateTime @default(now())
  reference   String?

  @@map("receipt_vouchers")
}

model AccountsPayable {
  id              String         @id @default(uuid()) @db.Uuid
  vendorInvoiceId String         @db.Uuid
  vendorInvoice   VendorInvoice  @relation(fields: [vendorInvoiceId], references: [id], onDelete: Cascade)
  vendorName      String
  amountDue       Decimal        @db.Decimal(12, 2)
  dueDate         DateTime
  agingBucket     String         @default("0-30") // 0-30, 31-60, 61-90, 90+
  status          String         @default("PENDING") // PENDING, SCHEDULED, PAID

  @@map("accounts_payables")
}

model AccountsReceivable {
  id                String          @id @default(uuid()) @db.Uuid
  customerInvoiceId String          @db.Uuid
  customerInvoice   CustomerInvoice @relation(fields: [customerInvoiceId], references: [id], onDelete: Cascade)
  customerName      String
  amountDue         Decimal         @db.Decimal(12, 2)
  dueDate           DateTime
  agingBucket       String          @default("0-30") // 0-30, 31-60, 61-90, 90+
  status            String          @default("OUTSTANDING") // OUTSTANDING, COLLECTED, BAD_DEBT

  @@map("accounts_receivables")
}

model BankAccount {
  id            String            @id @default(uuid()) @db.Uuid
  bankName      String
  accountNumber String            @unique
  iban          String?
  swiftCode     String?
  currency      String            @default("BDT")
  balance       Decimal           @default(0.00) @db.Decimal(12, 2)
  status        String            @default("ACTIVE")
  transactions  BankTransaction[]

  @@map("bank_accounts")
}

model BankTransaction {
  id            String      @id @default(uuid()) @db.Uuid
  bankAccountId String      @db.Uuid
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  txnType       String      // DEPOSIT, WITHDRAWAL, TRANSFER, FEE
  amount        Decimal     @db.Decimal(12, 2)
  reference     String?
  isReconciled  Boolean     @default(false)
  txnDate       DateTime    @default(now())

  @@map("bank_transactions")
}

model BankReconciliation {
  id             String   @id @default(uuid()) @db.Uuid
  bankAccountId  String   @db.Uuid
  statementDate  DateTime
  statementBal   Decimal  @db.Decimal(12, 2)
  ledgerBal      Decimal  @db.Decimal(12, 2)
  difference     Decimal  @db.Decimal(12, 2)
  isReconciled   Boolean  @default(false)
  reconciledAt   DateTime @default(now())

  @@map("bank_reconciliations")
}

model FinancialStatement {
  id            String   @id @default(uuid()) @db.Uuid
  statementType String   // TRIAL_BALANCE, BALANCE_SHEET, INCOME_STATEMENT, CASH_FLOW
  period        String   // e.g. 2026-07
  statementData Json
  generatedAt   DateTime @default(now())

  @@map("financial_statements")
}

model FinanceAnalytics {
  id               String   @id @default(uuid()) @db.Uuid
  metricName       String   @unique
  @@map("finance_analytics")
}

// ==========================================
// PHASE 11 - BOOK 10: ENTERPRISE POS, BILLING, INVOICING & RETAIL SALES MODELS
// ==========================================

model POSCounter {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     // e.g. Counter #1 (Ground Floor)
  code        String     @unique // e.g. CNT-001
  branchId    String?    @db.Uuid
  terminalIp  String?
  status      String     @default("ACTIVE") // ACTIVE, MAINTENANCE, INACTIVE
  shifts      POSShift[]
  createdAt   DateTime   @default(now())

  @@map("pos_counters")
}

model POSShift {
  id              String      @id @default(uuid()) @db.Uuid
  counterId       String      @db.Uuid
  counter         POSCounter  @relation(fields: [counterId], references: [id], onDelete: Cascade)
  cashierName     String
  startTime       DateTime    @default(now())
  endTime         DateTime?
  startingCash    Decimal     @db.Decimal(12, 2)
  closingCashCount Decimal?   @db.Decimal(12, 2)
  expectedCash    Decimal?    @db.Decimal(12, 2)
  cashVariance    Decimal?    @db.Decimal(12, 2)
  status          String      @default("OPEN") // OPEN, CLOSED
  sales           Sale[]
  drawers         CashDrawer[]

  @@map("pos_shifts")
}

model CashDrawer {
  id          String   @id @default(uuid()) @db.Uuid
  shiftId     String   @db.Uuid
  shift       POSShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  entryType   String   // DROP, PAYOUT, OPENING
  amount      Decimal  @db.Decimal(12, 2)
  reason      String?
  timestamp   DateTime @default(now())

  @@map("cash_drawers")
}

model Sale {
  id            String               @id @default(uuid()) @db.Uuid
  saleNo        String               @unique // e.g. SALE-100293
  shiftId       String?              @db.Uuid
  shift         POSShift?            @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  customerName  String               @default("Walk-in Customer")
  subtotal      Decimal              @db.Decimal(12, 2)
  taxAmount     Decimal              @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal             @default(0.00) @db.Decimal(12, 2)
  totalAmount   Decimal              @db.Decimal(12, 2)
  paymentStatus String               @default("PAID") // PAID, PARTIAL, SUSPENDED, REFUNDED
  channel       String               @default("POS") // POS, ECOMMERCE, WHATSAPP, PHONE
  items         SaleItem[]
  payments      PaymentTransaction[]
  invoices      RetailInvoice[]
  returns       ReturnOrder[]
  exchanges     ExchangeOrder[]
  createdAt     DateTime             @default(now())

  @@map("sales")
}

model SaleItem {
  id          String   @id @default(uuid()) @db.Uuid
  saleId      String   @db.Uuid
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  sku         String
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @default(0.00) @db.Decimal(5, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)

  @@map("sale_items")
}

model RetailInvoice {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceNo    String        @unique // e.g. INV-POS-1001
  saleId       String        @db.Uuid
  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customerName String
  subtotal     Decimal       @db.Decimal(12, 2)
  taxAmount    Decimal       @db.Decimal(12, 2)
  totalAmount  Decimal       @db.Decimal(12, 2)
  items        InvoiceItem[]
  issuedAt     DateTime      @default(now())

  @@map("retail_invoices")
}

model InvoiceItem {
  id          String        @id @default(uuid()) @db.Uuid
  invoiceId   String        @db.Uuid
  invoice     RetailInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal       @db.Decimal(12, 2)
  totalPrice  Decimal       @db.Decimal(12, 2)

  @@map("invoice_items")
}

model Quotation {
  id           String          @id @default(uuid()) @db.Uuid
  quoteNo      String          @unique // e.g. QTN-1001
  customerName String
  totalAmount  Decimal         @db.Decimal(12, 2)
  validUntil   DateTime
  status       String          @default("DRAFT") // DRAFT, SENT, ACCEPTED, EXPIRED
  items        QuotationItem[]
  createdAt    DateTime        @default(now())

  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(uuid()) @db.Uuid
  quoteId     String    @db.Uuid
  quote       Quotation @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productName String
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  lineTotal   Decimal   @db.Decimal(12, 2)

  @@map("quotation_items")
}

model ReturnOrder {
  id           String       @id @default(uuid()) @db.Uuid
  returnNo     String       @unique // e.g. RET-1001
  saleId       String       @db.Uuid
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  refundAmount Decimal      @db.Decimal(12, 2)
  reason       String
  status       String       @default("COMPLETED") // PENDING, COMPLETED, REJECTED
  items        ReturnItem[]
  createdAt    DateTime     @default(now())

  @@map("return_orders")
}

model ReturnItem {
  id          String      @id @default(uuid()) @db.Uuid
  returnId    String      @db.Uuid
  returnOrder ReturnOrder @relation(fields: [returnId], references: [id], onDelete: Cascade)
  sku         String
  quantity    Int
  refundPrice Decimal     @db.Decimal(12, 2)

  @@map("return_items")
}

model ExchangeOrder {
  id               String   @id @default(uuid()) @db.Uuid
  exchangeNo       String   @unique // e.g. EXC-1001
  saleId           String   @db.Uuid
  sale             Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  returnedSku      String
  replacementSku   String
  priceDifference  Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  @@map("exchange_orders")
}

model Coupon {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  discountType  String   @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT
  discountValue Decimal  @db.Decimal(12, 2)
  minOrderValue Decimal  @default(0.00) @db.Decimal(12, 2)
  expiryDate    DateTime
  usageCount    Int      @default(0)
  isActive      Boolean  @default(true)

  @@map("coupons")
}

model GiftCard {
  id             String   @id @default(uuid()) @db.Uuid
  cardNumber     String   @unique // e.g. GC-900293
  pinCode        String
  initialBalance Decimal  @db.Decimal(12, 2)
  currentBalance Decimal  @db.Decimal(12, 2)
  expiryDate     DateTime
  status         String   @default("ACTIVE")

  @@map("gift_cards")
}

model LoyaltyAccount {
  id           String   @id @default(uuid()) @db.Uuid
  customerName String   @unique
  tier         String   @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  totalPoints  Int      @default(0)
  activePoints Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("loyalty_accounts")
}

model PaymentTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  saleId        String   @db.Uuid
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod String   // CASH, CARD, BKASH, NAGAD, GIFT_CARD, WALLET
  amount        Decimal  @db.Decimal(12, 2)
  referenceNo   String?
  paidAt        DateTime @default(now())

  @@map("payment_transactions")
}

model SalesAnalytics {
  id               String   @id @default(uuid()) @db.Uuid
  metricName       String   @unique
  metricValue      Json
  lastCalculatedAt DateTime @default(now())

  @@map("sales_analytics")
}

model SalesTax {
  id          String   @id @default(uuid()) @db.Uuid
  taxName     String   @unique // e.g. VAT (5%), Sales Tax (10%)
  taxRate     Decimal  @db.Decimal(5, 2)
  isDefault   Boolean  @default(false)

  @@map("sales_taxes")
}

model SalesAudit {
  id          String   @id @default(uuid()) @db.Uuid
  action      String   // PRICE_OVERRIDE, VOID_SALE, DISCOUNT_APPLIED, CASH_DROP
  user        String
  details     String
  timestamp   DateTime @default(now())

  @@map("sales_audits")
}

// ==========================================
// PHASE 12: ENTERPRISE FRANCHISE, GLOBAL BI & AUTONOMOUS AI
// ==========================================

model Franchise {
  id              String               @id @default(uuid()) @db.Uuid
  name            String
  code            String               @unique
  ownerEmail      String
  status          String               @default("ACTIVE") // ACTIVE, SUSPENDED, TERMINATED
  royaltyRate     Float                @default(0.05)     // 5% default royalty
  territory       String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  agreements      FranchiseAgreement[]
  settlements     FranchiseSettlement[]

  @@map("franchises")
}

model FranchiseAgreement {
  id              String    @id @default(uuid()) @db.Uuid
  franchiseId     String    @db.Uuid
  contractNumber  String    @unique
  startDate       DateTime
  endDate         DateTime
  royaltyRate     Float
  status          String    @default("ACTIVE")
  signedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  franchise       Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@map("franchise_agreements")
}

model FranchiseSettlement {
  id              String    @id @default(uuid()) @db.Uuid
  franchiseId     String    @db.Uuid
  period          String    // e.g. "2026-07"
  grossRevenue    Float
  royaltyAmount   Float
  netPayout       Float
  status          String    @default("SETTLED") // PENDING, SETTLED, DISPUTED
  settledAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  franchise       Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@map("franchise_settlements")
}

model MultiRegionConfig {
  id              String   @id @default(uuid()) @db.Uuid
  regionCode      String   @unique // e.g. "US-EAST", "EU-WEST", "APAC-SOUTH"
  regionName      String
  primaryDbUrl    String
  readReplicaUrls String[]
  currency        String   @default("USD")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("multi_region_configs")
}

model EnterpriseBIReport {
  id              String   @id @default(uuid()) @db.Uuid
  reportType      String   // GLOBAL_ROLLUP, FRANCHISE_MATRIX, FORECAST
  period          String
  totalRevenue    Float
  totalExpense    Float
  netProfit       Float
  activeBranches  Int
  activeFranchises Int
  metricsJson     String   @db.Text
  generatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@map("enterprise_bi_reports")
}

model AutonomousAIOperation {
  id              String   @id @default(uuid()) @db.Uuid
  operationType   String   // SELF_HEALING, REORDER_TRIGGER, WORKLOAD_MATCHING, ESCALATION
  targetEntity    String
  status          String   @default("COMPLETED") // PENDING, EXECUTING, COMPLETED, FAILED
  detailsJson     String   @db.Text
  executionTimeMs Int
  executedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@map("autonomous_ai_operations")
}

// ==========================================
// PHASE 12 - BOOK 1: FRANCHISE TIERS, TERRITORY ZONES, ROYALTY INVOICES & COMPLIANCE
// ==========================================

model FranchiseTier {
  id                    String   @id @default(uuid()) @db.Uuid
  tierName              String   @unique // PLATINUM, GOLD, SILVER, BRONZE
  minRevenueThreshold   Float
  royaltyDiscountRate   Float    @default(0.0) // e.g., 0.01 = 1% discount
  marketingFundPercentage Float  @default(0.02) // 2% marketing fee
  perksJson             String   @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("franchise_tiers")
}

model TerritoryZone {
  id                  String   @id @default(uuid()) @db.Uuid
  zoneCode            String   @unique
  zoneName            String
  country             String   @default("US")
  stateRegion         String
  exclusiveRights     Boolean  @default(true)
  assignedFranchiseId String?  @db.Uuid
  status              String   @default("AVAILABLE") // AVAILABLE, ASSIGNED, RESERVED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("territory_zones")
}

model RoyaltyInvoice {
  id                  String    @id @default(uuid()) @db.Uuid
  invoiceNumber       String    @unique
  franchiseId         String    @db.Uuid
  billingPeriod       String    // e.g. "2026-Q3"
  grossSales          Float
  royaltyRate         Float
  baseRoyaltyFee      Float
  marketingFee        Float
  tierDiscount        Float     @default(0.0)
  totalDue            Float
  status              String    @default("ISSUED") // DRAFT, ISSUED, PAID, OVERDUE
  dueDate             DateTime
  paidAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("royalty_invoices")
}

model PartnerComplianceAudit {
  id                  String   @id @default(uuid()) @db.Uuid
  franchiseId         String   @db.Uuid
  auditDate           DateTime @default(now())
  auditorName         String
  complianceScore     Float    // 0 - 100
  complianceStatus    String   @default("PASSED") // PASSED, CONDITIONAL, FAILED
  findingsJson        String   @db.Text
  actionRequired      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("partner_compliance_audits")
}

// ==========================================
// PHASE 12 - BOOK 2: GLOBAL BI FORECASTING, CURRENCY ENGINE, AI RULES & CONSOLIDATED LEDGER
// ==========================================

model CurrencyExchangeRate {
  id              String   @id @default(uuid()) @db.Uuid
  fromCurrency    String   // USD, EUR, GBP, BDT, AED, etc.
  toCurrency      String
  exchangeRate    Float
  effectiveDate   DateTime @default(now())
  isCustomRate    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([fromCurrency, toCurrency, effectiveDate])
  @@map("currency_exchange_rates")
}

model ExecutiveBIForecast {
  id                      String   @id @default(uuid()) @db.Uuid
  forecastPeriod          String   // e.g. "2026-Q4", "2027-M01"
  projectedRevenue        Float
  projectedExpense        Float
  predictedEbitda         Float
  confidenceIntervalLower Float
  confidenceIntervalUpper Float
  assumptionsJson         String   @db.Text
  generatedAt             DateTime @default(now())
  createdAt               DateTime @default(now())

  @@map("executive_bi_forecasts")
}

model AutonomousAIRule {
  id               String    @id @default(uuid()) @db.Uuid
  ruleName         String    @unique
  triggerCondition String    // e.g. "STOCK_BELOW_REORDER_POINT", "TICKET_SLA_BREACH"
  actionType       String    // "AUTO_REORDER", "SELF_HEAL_QUEUE", "ESCALATE_MANAGER"
  isEnabled        Boolean   @default(true)
  priority         Int       @default(1)
  lastTriggeredAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("autonomous_ai_rules")
}

model GlobalConsolidatedLedger {
  id              String   @id @default(uuid()) @db.Uuid
  ledgerPeriod    String   // e.g. "2026-07"
  tenantCode      String   // e.g. "HEADQUARTERS", "FRANCHISE-TX01"
  accountCategory String   // REVENUE, OPEX, COGS, ASSET, LIABILITY
  totalDebit      Float    @default(0.0)
  totalCredit     Float    @default(0.0)
  netBalance      Float    @default(0.0)
  currency        String   @default("USD")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("global_consolidated_ledgers")
}

// ==========================================
// PHASE 12 - BOOK 3: REPLICATION LOGS, WORKLOAD ALLOCATION, PORTAL CONFIG & INCIDENT HEALING
// ==========================================

model CrossClusterReplicationLog {
  id                    String   @id @default(uuid()) @db.Uuid
  clusterId             String
  sourceRegion          String   // e.g. "us-east-1"
  targetRegion          String   // e.g. "eu-west-1"
  replicationLagMs      Int      @default(0)
  status                String   @default("HEALTHY") // HEALTHY, LAG_WARNING, DESYNCED
  replicatedRecordsCount Int     @default(0)
  lastSyncedAt          DateTime @default(now())
  createdAt             DateTime @default(now())

  @@map("cross_cluster_replication_logs")
}

model AIWorkloadAllocation {
  id                    String   @id @default(uuid()) @db.Uuid
  branchId              String   @db.Uuid
  technicianId          String   @db.Uuid
  predictedCapacityHours Float
  allocatedWorkloadHours Float
  optimizationScore     Float    // 0 - 100
  recommendationJson    String   @db.Text
  allocatedDate         DateTime @default(now())
  createdAt             DateTime @default(now())

  @@map("ai_workload_allocations")
}

model FranchiseePortalConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  franchiseId         String   @unique @db.Uuid
  customDomain        String?  @unique
  primaryColor        String   @default("#0f172a")
  featureTogglesJson  String   @db.Text
  apiRateLimitPerMin  Int      @default(600)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("franchisee_portal_configs")
}

model SelfHealingWorkflowIncident {
  id               String    @id @default(uuid()) @db.Uuid
  incidentCode     String    @unique // e.g. "INC-2026-001"
  severity         String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  rootCause        String
  resolutionAction String
  status           String    @default("RESOLVED") // OPEN, IN_PROGRESS, RESOLVED, ESCALATED
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("self_healing_workflow_incidents")
}

// ==========================================
// PHASE 12 - BOOK 4: MASTER DATA GOVERNANCE, DR AUDITS, SLA BENCHMARKS & PREDICTIVE MAINTENANCE
// ==========================================

model MasterDataGovernanceRule {
  id                  String   @id @default(uuid()) @db.Uuid
  entityType          String   // CUSTOMER, PART_CATALOG, FRANCHISE, FINANCIAL_LEDGER
