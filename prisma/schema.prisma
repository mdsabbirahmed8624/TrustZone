  name        String             @unique
  description String?
  isDefault   Boolean            @default(false)
  stages      OpportunityStage[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("sales_pipelines")
}

model OpportunityStage {
  id            String        @id @default(uuid()) @db.Uuid
  pipelineId    String        @db.Uuid
  pipeline      SalesPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name          String
  displayOrder  Int           @default(1)
  probability   Int           @default(20) // 0 - 100 % win probability
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())

  @@map("opportunity_stages")
}

model Opportunity {
  id               String           @id @default(uuid()) @db.Uuid
  title            String
  amount           Decimal          @default(0.00) @db.Decimal(12, 2)
  expectedRevenue  Decimal          @default(0.00) @db.Decimal(12, 2)
  probability      Int              @default(20)
  closeDate        DateTime?
  status           String           @default("OPEN") // OPEN, WON, LOST
  lossReason       String?
  competitor       String?
  customerId       String?          @db.Uuid
  customer         Customer?        @relation(fields: [customerId], references: [id])
  stageId          String           @db.Uuid
  stage            OpportunityStage @relation(fields: [stageId], references: [id])
  assignedToId     String?          @db.Uuid
  assignedTo       User?            @relation("OpportunityAssignedUser", fields: [assignedToId], references: [id])
  tasks            SalesTask[]
  notes            CRMNote[]
  attachments      CRMAttachment[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("opportunities")
}

model SalesTask {
  id            String       @id @default(uuid()) @db.Uuid
  opportunityId String?      @db.Uuid
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  taskType      String       @default("CALL") // CALL, EMAIL, MEETING, DEMO, QUOTE
  status        String       @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  priority      String       @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate       DateTime?
  assignedToId  String?      @db.Uuid
  completedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@map("sales_tasks")
}

model Campaign {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  channel      String           @default("EMAIL") // EMAIL, SMS, WHATSAPP, MULTI_CHANNEL
  status       String           @default("DRAFT") // DRAFT, SCHEDULED, ACTIVE, COMPLETED, PAUSED, CANCELLED
  subject      String?
  bodyContent  String?
  targetSegment String?
  budget       Decimal          @default(0.00) @db.Decimal(10, 2)
  actualCost   Decimal          @default(0.00) @db.Decimal(10, 2)
  revenueGenerated Decimal      @default(0.00) @db.Decimal(12, 2)
  scheduledAt  DateTime?
  sentAt       DateTime?
  createdById  String?          @db.Uuid
  createdBy    User?            @relation("CampaignCreatedUser", fields: [createdById], references: [id])
  members      CampaignMember[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("campaigns")
}

