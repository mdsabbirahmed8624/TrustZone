model Lead {
  id                   String         @id @default(uuid()) @db.Uuid
  firstName            String
  lastName             String
  email                String?
  phone                String?
  company              String?
  source               String         @default("WEBSITE") // WEBSITE, REFERRAL, WALK_IN, CAMPAIGN, PARTNER, PHONE
  status               String         @default("NEW") // NEW, CONTACTED, QUALIFIED, UNQUALIFIED, CONVERTED, ARCHIVED
  leadScore            Int            @default(10) // 0 - 100
  rating               String         @default("WARM") // COLD, WARM, HOT
  estimatedValue       Decimal        @default(0.00) @db.Decimal(10, 2)
  assignedToId         String?        @db.Uuid
  assignedTo           User?          @relation("LeadAssignedUser", fields: [assignedToId], references: [id])
  convertedCustomerId  String?        @db.Uuid
  convertedOpportunityId String?      @db.Uuid
  notes                String?
  tags                 String[]       @default([])
  activities           LeadActivity[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

