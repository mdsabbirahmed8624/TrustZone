// ==========================================
// NEW FINANCE & ACCOUNTING MODELS
// ==========================================

model FiscalYear {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @unique // e.g. "FY2026"
  startDate DateTime
  endDate   DateTime
  status    String             @default("ACTIVE") // ACTIVE, CLOSED
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  periods   AccountingPeriod[]

  @@map("fiscal_years")
}

model AccountingPeriod {
  id             String         @id @default(uuid()) @db.Uuid
  fiscalYearId   String         @db.Uuid
  fiscalYear     FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  name           String         // e.g. "2026-07"
  startDate      DateTime
  endDate        DateTime
  isLocked       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  journalEntries JournalEntry[]

  @@map("accounting_periods")
}

model FinancialAccount {
  id             String              @id @default(uuid()) @db.Uuid
  accountNumber  String              @unique // e.g., "1010", "1200", "2000"
  name           String
  parentAccountId String?             @db.Uuid
  parentAccount  FinancialAccount?   @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts  FinancialAccount[]  @relation("AccountHierarchy")
  accountClass   String              // ASSET, LIABILITY, EQUITY, INCOME, EXPENSE
  accountType    String              // CASH, BANK, MOBILE_BANKING, RECEIVABLE, PAYABLE, INVENTORY, COGS, REVENUE, EXPENSE, EQUITY_OWNER, etc.
  normalBalance  String              // DEBIT, CREDIT
  branchId       String?             @db.Uuid
  branch         Branch?             @relation(fields: [branchId], references: [id])
  openingBalance Decimal             @default(0.00) @db.Decimal(10, 2)
  currentBalance Decimal             @default(0.00) @db.Decimal(10, 2)
  bankName       String?
  accountNumberStr String?           // Literal bank account number (avoid collision with accountNumber)
  bankBranch     String?
  mobileNumber   String?             // For mobile banking accounts
  status         String              @default("active") // active, inactive
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  journalLines   JournalLine[]
  transfersFrom  AccountTransfer[]   @relation("FromAccount")
  transfersTo    AccountTransfer[]   @relation("ToAccount")
  expensesPaid   Expense[]           @relation("AccountPaid")
  incomesReceived Income[]           @relation("AccountReceived")
  adjustments    AccountAdjustment[]
  payments       Payment[]

  @@map("financial_accounts")
}

model JournalEntry {
  id              String           @id @default(uuid()) @db.Uuid
  voucherNumber   String           @unique // e.g. "JV-2026-00001"
  date            DateTime         @default(now())
  description     String?
  referenceModule String           // REPAIR, INVOICE, PAYMENT, EXPENSE, INCOME, PURCHASE, TRANSFER, ADJUSTMENT
  referenceId     String?          // ID of original related item
  branchId        String           @db.Uuid
  branch          Branch           @relation(fields: [branchId], references: [id])
  periodId        String           @db.Uuid
  period          AccountingPeriod @relation(fields: [periodId], references: [id])
  createdById     String           @db.Uuid
  createdBy       User             @relation(fields: [createdById], references: [id])
  isReversal      Boolean          @default(false)
  reversedEntryId String?          @db.Uuid @unique
  reversalEntry   JournalEntry?    @relation("ReversalEntry", fields: [reversedEntryId], references: [id])
  reversedByEntry JournalEntry?    @relation("ReversalEntry")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  lines           JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id            String           @id @default(uuid()) @db.Uuid
  entryId       String           @db.Uuid
  entry         JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId     String           @db.Uuid
  account       FinancialAccount @relation(fields: [accountId], references: [id])
  debit         Decimal          @default(0.00) @db.Decimal(10, 2)
  credit        Decimal          @default(0.00) @db.Decimal(10, 2)
  description   String?
  customerId    String?          @db.Uuid
  customer      Customer?        @relation(fields: [customerId], references: [id])
  supplierId    String?          @db.Uuid
  supplier      Supplier?        @relation(fields: [supplierId], references: [id])
  createdAt     DateTime         @default(now())

  @@map("journal_lines")
}

model Expense {
  id            String           @id @default(uuid()) @db.Uuid
  category      String           // Rent, Salary, Electricity, Internet, Marketing, Equipment, Transport, Maintenance, Miscellaneous
  amount        Decimal          @db.Decimal(10, 2)
  date          DateTime         @default(now())
  status        String           @default("PENDING") // PENDING, APPROVED, REJECTED
  receiptUrl    String?
  notes         String?
  branchId      String           @db.Uuid
  branch        Branch           @relation(fields: [branchId], references: [id])
  accountId     String?          @db.Uuid
  account       FinancialAccount? @relation("AccountPaid", fields: [accountId], references: [id])
  createdById   String           @db.Uuid
  createdBy     User             @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  approvedById  String?          @db.Uuid
  approvedBy    User?            @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("expenses")
}

model Income {
  id            String           @id @default(uuid()) @db.Uuid
  category      String           // Repair Income, Product Sales, Service Charges, Delivery Charges, Other Income
  amount        Decimal          @db.Decimal(10, 2)
  date          DateTime         @default(now())
  description   String?
  branchId      String           @db.Uuid
  branch        Branch           @relation(fields: [branchId], references: [id])
  accountId     String           @db.Uuid
  account       FinancialAccount @relation("AccountReceived", fields: [accountId], references: [id])
  createdById   String           @db.Uuid
  createdBy     User             @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("incomes")
}

model AccountTransfer {
  id            String           @id @default(uuid()) @db.Uuid
  fromAccountId String           @db.Uuid
  fromAccount   FinancialAccount @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccountId   String           @db.Uuid
  toAccount     FinancialAccount @relation("ToAccount", fields: [toAccountId], references: [id])
  amount        Decimal          @db.Decimal(10, 2)
  date          DateTime         @default(now())
  reference     String?
  createdById   String           @db.Uuid
  createdBy     User             @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("account_transfers")
}

model AccountAdjustment {
  id            String           @id @default(uuid()) @db.Uuid
  accountId     String           @db.Uuid
  account       FinancialAccount @relation(fields: [accountId], references: [id])
  amountDelta   Decimal          @db.Decimal(10, 2) // Positive or negative
  type          String           // INCREASE, DECREASE
  reason        String
  createdById   String           @db.Uuid
  createdBy     User             @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())

  @@map("account_adjustments")
}

model DailyClosing {
  id              String         @id @default(uuid()) @db.Uuid
  branchId        String         @db.Uuid
  branch          Branch         @relation(fields: [branchId], references: [id])
  date            DateTime       @db.Date
  status          String         @default("PENDING") // PENDING, CLOSED
  expectedBalance Decimal        @db.Decimal(10, 2)
  actualBalance   Decimal        @db.Decimal(10, 2)
  difference      Decimal        @db.Decimal(10, 2)
  closedById      String         @db.Uuid
  closedBy        User           @relation(fields: [closedById], references: [id])
