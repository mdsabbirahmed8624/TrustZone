  id                String        @id @default(uuid()) @db.Uuid
  referenceId       String        @db.Uuid
  fileUrl           String
  
  isDeleted         Boolean       @default(false)
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())

  @@map("inventory_attachments")
}

model PurchaseRequest {
  id                    String            @id @default(uuid()) @db.Uuid
  partId                String            @db.Uuid
  part                  Part              @relation(fields: [partId], references: [id], onDelete: Cascade)
  quantity              Int
  branchId              String            @db.Uuid
  branch                Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  requestedById          String            @db.Uuid
  requestedBy            User              @relation("RequestedPurchaseRequests", fields: [requestedById], references: [id])
  status                String            @default("PENDING_MANAGER") // PENDING_MANAGER, APPROVED_MANAGER, APPROVED_PROCUREMENT, APPROVED_FINANCE, REJECTED, ORDERED
  
  managerApprovedById   String?           @db.Uuid
  managerApprovedBy     User?             @relation("ManagerApprovedRequests", fields: [managerApprovedById], references: [id])
  procurementApprovedById String?         @db.Uuid
  procurementApprovedBy   User?             @relation("ProcurementApprovedRequests", fields: [procurementApprovedById], references: [id])
  financeApprovedById   String?           @db.Uuid
  financeApprovedBy     User?             @relation("FinanceApprovedRequests", fields: [financeApprovedById], references: [id])
  
  rejectionReason       String?
  purchaseOrders        PurchaseOrder[]
  
  isDeleted             Boolean           @default(false)
  deletedAt             DateTime?
  version               Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@map("purchase_requests")
}

model PurchaseOrderApproval {
  id                String        @id @default(uuid()) @db.Uuid
  purchaseOrderId   String        @db.Uuid
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  approverId        String        @db.Uuid
  approver          User          @relation(fields: [approverId], references: [id])
  level             Int           // 1 = Manager, 2 = Procurement, 3 = Finance
  status            String        // APPROVED, REJECTED
  comments          String?
  createdAt         DateTime      @default(now())

  @@map("purchase_order_approvals")
}

model SupplierDocument {
  id             String          @id @default(uuid()) @db.Uuid
  supplierId     String          @db.Uuid
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name           String
  fileUrl        String
  documentType   String          // CONTRACT, NDA, TAX_FORM, QUOTATION
  createdAt      DateTime        @default(now())

  @@map("supplier_documents")
}

model ProcurementAttachment {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  fileUrl         String
  attachmentType  String        // INVOICE, CHALLAN, RECEIVING_PHOTO
  createdAt       DateTime      @default(now())

  @@map("procurement_attachments")
}

model AnalyticsSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  snapshotType String   // DAILY, WEEKLY, MONTHLY, ANNUAL
  metrics      Json     // Aggregated KPIs, financial summaries, and ticket volume
  createdAt    DateTime @default(now())

  @@index([snapshotType])
  @@index([createdAt])
  @@map("analytics_snapshots")
}


model ScheduledReport {
  id         String          @id @default(uuid()) @db.Uuid
  name       String
  reportType String          // EXECUTIVE, INVENTORY, FINANCE, REPAIR
  frequency  String          // DAILY, WEEKLY, MONTHLY
  recipients String[]
  branchId   String?         @db.Uuid
  isDeleted  Boolean         @default(false)
  deletedAt  DateTime?
  version    Int             @default(0)
  createdAt  DateTime        @default(now())
  histories  ReportHistory[]

  @@map("scheduled_reports")
}

model BusinessMetric {
  id         String   @id @default(uuid()) @db.Uuid
  metricKey  String   // e.g., daily_revenue, completed_repairs
  metricValue Float
  branchId   String?  @db.Uuid
  recordedAt DateTime @default(now())

  @@index([metricKey])
  @@index([recordedAt])
  @@map("business_metrics")
}

model KPIConfiguration {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  formulaKey  String   // e.g., first_time_fix_rate, avg_resolution_time
  targetValue Float
  config      Json?
  createdAt   DateTime @default(now())

  @@unique([formulaKey])
  @@map("kpi_configurations")
}

model ReportHistory {
  id                String           @id @default(uuid()) @db.Uuid
  scheduledReportId String?          @db.Uuid
  scheduledReport   ScheduledReport? @relation(fields: [scheduledReportId], references: [id], onDelete: Cascade)
  reportName        String
  fileUrl           String
  format            String           // PDF, EXCEL, CSV, JSON
  generatedById     String?          @db.Uuid
  generatedBy       User?            @relation(fields: [generatedById], references: [id])
  createdAt         DateTime         @default(now())

  @@map("report_histories")
}

model AlertAnalytics {
  id         String    @id @default(uuid()) @db.Uuid
  alertType  String    // REVENUE_DROP, LOW_PRODUCTIVITY, BACKLOG_WARNING, SLA_VIOLATION
  severity   String    // LOW, MEDIUM, HIGH, CRITICAL
  message    String
  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([alertType])
  @@index([isResolved])
  @@map("alert_analytics")
}

model ForecastHistory {
  id             String   @id @default(uuid()) @db.Uuid
  forecastType   String   // REVENUE, INVENTORY, PROCUREMENT, WORKLOAD
  historicalData Json
  projectedData  Json
  confidenceLevel Float
  createdAt      DateTime @default(now())

  @@index([forecastType])
  @@map("forecast_histories")
}

model PredictionHistory {
  id             String    @id @default(uuid()) @db.Uuid
  predictionType String    // DEVICE_FAILURE, BATTERY_DEGRADATION, CHARGING_IC_FAILURE, WATER_DAMAGE_RISK, LIFESPAN
  targetId       String    @db.Uuid
  predictionData Json
  confidenceLevel Float
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  version        Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([predictionType])
  @@index([targetId])
  @@map("prediction_histories")
}

model RecommendationHistory {
  id                 String    @id @default(uuid()) @db.Uuid
  recommendationType String    // SPARE_PARTS, TECHNICIAN_ASSIGNMENT, PROCUREMENT_QUANTITY, WIDGET_COMPATIBILITY
  targetId           String    @db.Uuid
  recommendationData Json
  confidenceLevel    Float
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  version            Int       @default(0)
  createdAt          DateTime  @default(now())

  @@index([recommendationType])
  @@index([targetId])
  @@map("recommendation_histories")
}

model KnowledgeArticle {
  id                  String             @id @default(uuid()) @db.Uuid
  title               String
  content             String
  tags                String[]
  category            String
  knowledgeCategoryId String?            @db.Uuid
  knowledgeCategory   KnowledgeCategory? @relation(fields: [knowledgeCategoryId], references: [id])
  views               Int                @default(0)
  isDeleted           Boolean            @default(false)
  deletedAt           DateTime?
  version             Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  searches            KnowledgeSearch[]

  @@map("knowledge_articles")
}

model KnowledgeSearch {
  id        String            @id @default(uuid()) @db.Uuid
  query     String
  userId    String            @db.Uuid
  user      User              @relation(fields: [userId], references: [id])
  articleId String?           @db.Uuid
  article   KnowledgeArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())

  @@map("knowledge_searches")
}

model CustomerInsight {
  id                String    @id @default(uuid()) @db.Uuid
  customerId        String    @db.Uuid
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  churnRisk         Float
  lifetimeValue     Float
  satisfactionScore Float
  warrantyLikelihood Float
  insightData       Json?
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?
  version           Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("customer_insights")
}

model DemandForecast {
  id              String    @id @default(uuid()) @db.Uuid
  partId          String    @db.Uuid
  part            Part      @relation(fields: [partId], references: [id], onDelete: Cascade)
  projectedDemand Float
  forecastPeriod  String    // e.g., "2026-08"
  confidenceLevel Float
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  version         Int       @default(0)
  createdAt       DateTime  @default(now())

  @@map("demand_forecasts")
}

model RepairPrediction {
  id                  String    @id @default(uuid()) @db.Uuid
  ticketId            String    @db.Uuid
  ticket              Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  probableFault       String
  suggestedRepairPath String[]
  estimatedComplexity String    // LOW, MEDIUM, HIGH
  estimatedPartsCost  Decimal   @db.Decimal(10, 2)
  estimatedLaborCost  Decimal   @db.Decimal(10, 2)
  confidenceScore     Float
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  version             Int       @default(0)
  createdAt           DateTime  @default(now())

  @@map("repair_predictions")
}

model AIAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String   // e.g., RUN_PREDICTION, GENERATE_RECOMMENDATION
  modelName    String
  inputPayload Json
  outputPayload Json
  createdAt    DateTime @default(now())

  @@map("ai_audit_logs")
}

// ==========================================
// PHASE 11 - BOOK 1: INTEGRATION PLATFORM MODELS
// ==========================================

model IntegrationProvider {
  id               String                  @id @default(uuid()) @db.Uuid
  code             String                  @unique // QUICKBOOKS, XERO, SHOPIFY, WOOCOMMERCE, STRIPE, TWILIO, SENDGRID, FCM, WHATSAPP, AWS_S3
  name             String
  category         String                  // ACCOUNTING, MARKETPLACE, PAYMENT, MESSAGING, STORAGE
  description      String?
  supportedModes   String[]                @default(["SANDBOX", "PRODUCTION"])
  isDeleted        Boolean                 @default(false)
  deletedAt        DateTime?
  version          Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  credentials      IntegrationCredential[]

  @@map("integration_providers")
}

model IntegrationCredential {
  id               String              @id @default(uuid()) @db.Uuid
  providerId       String              @db.Uuid
  provider         IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  environment      String              @default("SANDBOX") // SANDBOX, PRODUCTION
  apiKey           String?
  apiSecret        String?
  accessToken      String?
  refreshToken     String?
  tokenExpiresAt   DateTime?
  webhookSecret    String?
  endpointUrl      String?
  configJson       Json?
  retryLimit       Int                 @default(3)
  timeoutMs        Int                 @default(10000)
  rateLimitPerMin  Int                 @default(60)
  logLevel         String              @default("INFO") // DEBUG, INFO, WARN, ERROR
  status           String              @default("ACTIVE") // ACTIVE, INACTIVE, ERROR
  isDeleted        Boolean             @default(false)
  deletedAt        DateTime?
  version          Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([providerId, environment])
  @@map("integration_credentials")
}

model ApiClient {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  clientKey    String   @unique
  clientSecret String
  ownerId      String?  @db.Uuid
  owner        User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  allowedIps   String[] @default([])
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  version      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apiKeys      ApiKey[]

  @@map("api_clients")
}

model ApiKey {
  id           String    @id @default(uuid()) @db.Uuid
  clientId     String    @db.Uuid
  client       ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  keyHash      String    @unique
  name         String
  scopes       String[]  @default(["read", "write"])
  rateLimit    Int       @default(100) // Requests per minute
  expiresAt    DateTime?
  revoked      Boolean   @default(false)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("api_keys")
}

model WebhookEndpoint {
  id             String            @id @default(uuid()) @db.Uuid
  ownerId        String?           @db.Uuid
  owner          User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  targetUrl      String
  secretKey      String
  events         String[]          // e.g. ["ticket.created", "invoice.paid", "stock.low"]
  description    String?
  status         String            @default("ACTIVE") // ACTIVE, PAUSED, DISABLED
  isDeleted      Boolean           @default(false)
  deletedAt      DateTime?
  version        Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  deliveries     WebhookDelivery[]

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id               String          @id @default(uuid()) @db.Uuid
  endpointId       String          @db.Uuid
  endpoint         WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event            String
  payload          Json
  httpStatus       Int?
  responseBody     String?
  executionTimeMs  Int?
  retryCount       Int             @default(0)
  status           String          @default("PENDING") // PENDING, SUCCESS, FAILED, DLQ
  replayed         Boolean         @default(false)
  lastAttemptAt    DateTime?
  createdAt        DateTime        @default(now())

  @@map("webhook_deliveries")
}

model SyncJob {
  id             String   @id @default(uuid()) @db.Uuid
  providerCode   String   // QUICKBOOKS, XERO, SHOPIFY, WOOCOMMERCE
  syncType       String   // FULL, INCREMENTAL
  entityType     String   // CUSTOMER, INVOICE, PRODUCT, ORDER, PAYMENT
  status         String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  itemsTotal     Int      @default(0)
  itemsProcessed Int      @default(0)
  itemsFailed    Int      @default(0)
  conflicts      Json?
  errorDetails   String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("sync_jobs")
}

model IntegrationLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  providerCode  String?
  environment   String   @default("SANDBOX")
  action        String
  requestPath   String?
  statusCode    Int?
  details       String?
  payload       Json?
  createdAt     DateTime @default(now())

  @@map("integration_logs")
}

model ExternalSystem {
  id           String   @id @default(uuid()) @db.Uuid
  systemName   String   @unique
  systemType   String   // ERP, CRM, WMS, POS, ECOMMERCE
  baseUrl      String?
  authType     String   @default("OAUTH2") // API_KEY, OAUTH2, BASIC
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  version      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("external_systems")
}

model IdempotencyKey {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String?              @db.Uuid
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  idempotencyKey String               @unique
  requestPath    String
  requestHash    String
  responseStatus Int
  responseBody   Json
  isLocked       Boolean              @default(false)
  expiresAt      DateTime
  createdAt      DateTime             @default(now())

  replays        IdempotencyRequest[]

  @@map("idempotency_keys")
}

model IdempotencyRequest {
  id             String         @id @default(uuid()) @db.Uuid
  keyId          String         @db.Uuid
  idempotencyKey IdempotencyKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  ipAddress      String?
  userAgent      String?
  replayedAt     DateTime       @default(now())

  @@map("idempotency_requests")
}

// ==========================================
// PHASE 11 - BOOK 2: WORKFLOW AUTOMATION & SCHEDULER MODELS
// ==========================================

model WorkflowVersion {
  id             String             @id @default(uuid()) @db.Uuid
  definitionId   String             @db.Uuid
  definition     WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  versionNumber  Int
  status         String             @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  graphDefinition Json              // Step nodes, conditions, parallel branches
  isDeleted      Boolean            @default(false)
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  executions     WorkflowExecution[]

  @@unique([definitionId, versionNumber])
  @@map("workflow_versions")
}

model WorkflowExecution {
  id              String            @id @default(uuid()) @db.Uuid
  versionId       String            @db.Uuid
  version         WorkflowVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  userId          String?           @db.Uuid
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  recordId        String?           // e.g. ticketId, invoiceId
  triggerEvent    String
  status          String            @default("RUNNING") // RUNNING, COMPLETED, FAILED, WAITING_APPROVAL, CANCELLED
  currentStepNode String?
  variables       Json?
  startedAt       DateTime          @default(now())
  finishedAt      DateTime?

  logs            WorkflowLog[]

  @@map("workflow_executions")
}

model WorkflowStep {
  id           String   @id @default(uuid()) @db.Uuid
  stepName     String
  stepType     String   // ACTION, CONDITION, PARALLEL, APPROVAL, DELAY
  configJson   Json
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("workflow_steps")
}

model WorkflowLog {
  id           String            @id @default(uuid()) @db.Uuid
  executionId  String            @db.Uuid
  execution    WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stepNode     String
  status       String            // SUCCESS, FAILED, SKIPPED
  output       Json?
  errorDetails String?
  createdAt    DateTime          @default(now())

  @@map("workflow_logs")
}

model BackgroundJob {
  id            String         @id @default(uuid()) @db.Uuid
  queueName     String         @default("DEFAULT") // DEFAULT, HIGH_PRIORITY, REPORTS, EMAILS
  jobType       String
  payload       Json
  priority      String         @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status        String         @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, DLQ
  scheduledAt   DateTime       @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  retryCount    Int            @default(0)
  maxRetries    Int            @default(3)
  errorDetails  String?
  isDeleted     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  executions    JobExecution[]

  @@map("background_jobs")
}

model JobExecution {
  id              String        @id @default(uuid()) @db.Uuid
  jobId           String        @db.Uuid
  job             BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId        String?
  status          String        // SUCCESS, FAILED
  executionTimeMs Int
  errorStack      String?
  executedAt      DateTime      @default(now())

  @@map("job_executions")
}

model ScheduledTask {
  id                String    @id @default(uuid()) @db.Uuid
  taskName          String    @unique
  cronExpression    String
  actionType        String
  timezone          String    @default("UTC")
  businessHoursOnly Boolean   @default(false)
  holidayExclusion  Boolean   @default(false)
  enabled           Boolean   @default(true)
  lastRunAt         DateTime?
  nextRunAt         DateTime?
  isDeleted         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("scheduled_tasks")
}

model BusinessRule {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  triggerEvent   String    // e.g. TICKET_CREATED, INVOICE_PAID, STOCK_LOW
  conditionGroup Json      // AND/OR conditions tree
  actions        Json      // Array of automated actions
  priority       Int       @default(10)
  enabled        Boolean   @default(true)
  isDeleted      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("business_rules")
}

model ApprovalRequest {
  id             String            @id @default(uuid()) @db.Uuid
  requesterId    String?           @db.Uuid
  requester      User?             @relation("RequesterApprovals", fields: [requesterId], references: [id], onDelete: SetNull)
  approverId     String?           @db.Uuid
  approver       User?             @relation("ApproverApprovals", fields: [approverId], references: [id], onDelete: SetNull)
  approvalType   String            // SINGLE, MULTI_LEVEL, PARALLEL
  resourceModule String            // PURCHASE_ORDER, EXPENSE, DISCOUNT, TICKET
  resourceId     String
  stepNumber     Int               @default(1)
  totalSteps     Int               @default(1)
  status         String            @default("PENDING") // PENDING, APPROVED, REJECTED, ESCALATED, EXPIRED
  timeoutHours   Int               @default(24)
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  history        ApprovalHistory[]

  @@map("approval_requests")
}

model ApprovalHistory {
  id             String          @id @default(uuid()) @db.Uuid
  requestId      String          @db.Uuid
  request        ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action         String          // SUBMITTED, APPROVED, REJECTED, ESCALATED
  comments       String?
  actedById      String?         @db.Uuid
  actedByName    String?
  createdAt      DateTime        @default(now())

  @@map("approval_histories")
}

model Reminder {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipient    String
  channel      String   // EMAIL, SMS, WHATSAPP, PUSH
  subject      String?
  message      String
  sendAt       DateTime
  status       String   @default("PENDING") // PENDING, SENT, FAILED, CANCELLED
  sentAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("reminders")
}

model EscalationRule {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  module           String   // TICKETS, APPROVALS, INVENTORY
  thresholdHours   Int
  escalateToRole   String   // MANAGER, SUPER_ADMIN
  action           String   // NOTIFY, REASSIGN, AUTO_APPROVE
  enabled          Boolean  @default(true)
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("escalation_rules")
}

// ==========================================
// PHASE 11 - BOOK 3: DOCUMENT MANAGEMENT & DIGITAL ASSETS
// ==========================================

model DocumentFolder {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  parentId     String?          @db.Uuid
  parent       DocumentFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     DocumentFolder[] @relation("FolderHierarchy")
  department   String?
  ownerId      String?          @db.Uuid
  isDeleted    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  documents    Document[]

  @@map("document_folders")
}

model DocumentCategory {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @unique
  description  String?
  code         String     @unique // e.g. CONTRACT, INVOICE, SCHEMATIC, HR, TECH_SPEC
  isDeleted    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  documents    Document[]

  @@map("document_categories")
}

model DocumentTag {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @unique
  createdAt    DateTime   @default(now())

  documents    Document[] @relation("DocumentToTag")

  @@map("document_tags")
}

model Document {
  id              String            @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  folderId        String?           @db.Uuid
  folder          DocumentFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  categoryId      String?           @db.Uuid
  category        DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ownerId         String?           @db.Uuid
  owner           User?             @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  department      String?
  status          String            @default("DRAFT") // DRAFT, UNDER_REVIEW, APPROVED, REJECTED, PUBLISHED, EXPIRED, ARCHIVED
  isLegalHold     Boolean           @default(false)
  isDeleted       Boolean           @default(false)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tags            DocumentTag[]     @relation("DocumentToTag")
  versions        DocumentVersion[]
  metadata        DocumentMetadata[]
  shares          DocumentShare[]
  permissions     DocumentPermission[]
  reviews         DocumentReview[]
  approvals       DocumentApproval[]
  retentions      DocumentRetention[]
  audits          DocumentAudit[]
  ocrResults      OCRResult[]
  digitalAssets   DigitalAsset[]

  @@map("documents")
}

model DocumentVersion {
  id             String      @id @default(uuid()) @db.Uuid
  documentId     String      @db.Uuid
  document       Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  majorVersion   Int         @default(1)
  minorVersion   Int         @default(0)
  filePath       String
  fileSize       Int
  mimeType       String
  checksumSha256 String
  storageProvider String     @default("LOCAL") // LOCAL, AWS_S3, AZURE_BLOB
  isLocked       Boolean     @default(false)
  comment        String?
  createdAt      DateTime    @default(now())

  @@map("document_versions")
}

model DocumentMetadata {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @db.Uuid
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  key         String
  value       String
  createdAt   DateTime @default(now())

  @@unique([documentId, key])
  @@map("document_metadata")
}

model DocumentShare {
  id           String    @id @default(uuid()) @db.Uuid
  documentId   String    @db.Uuid
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sharedById   String?   @db.Uuid
  sharedBy     User?     @relation(fields: [sharedById], references: [id], onDelete: SetNull)
  shareToken   String    @unique @default(uuid())
  recipientEmail String?
  isViewOnly   Boolean   @default(false)
  isWatermarked Boolean  @default(true)
  watermarkText String?
  maxDownloads Int?
  downloadCount Int      @default(0)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  @@map("document_shares")
}

model DocumentPermission {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @db.Uuid
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role         String?  // e.g. TECHNICIAN, MANAGER
  userId       String?  @db.Uuid
  accessLevel  String   @default("READ") // READ, WRITE, DELETE, SHARE
  createdAt    DateTime @default(now())

  @@map("document_permissions")
}

model DocumentReview {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @db.Uuid
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewerId   String?  @db.Uuid
  status       String   @default("PENDING") // PENDING, COMPLETED
  comments     String?
  createdAt    DateTime @default(now())

  @@map("document_reviews")
}

model DocumentApproval {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @db.Uuid
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approverId   String?  @db.Uuid
  decision     String   // APPROVED, REJECTED
  comments     String?
  actedAt      DateTime @default(now())

  @@map("document_approvals")
}

model DocumentRetention {
  id               String    @id @default(uuid()) @db.Uuid
  documentId       String    @db.Uuid
  document         Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  policyName       String
  retentionDays    Int
  autoAction       String    @default("ARCHIVE") // ARCHIVE, PERMANENT_DELETE
  scheduledActionAt DateTime
  isCompleted      Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@map("document_retentions")
}

model DocumentAudit {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @db.Uuid
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId       String?  @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String   // VIEW, DOWNLOAD, EDIT, SHARE, DELETE, ROLLBACK
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@map("document_audits")
}

model OCRResult {
  id              String   @id @default(uuid()) @db.Uuid
  documentId      String   @db.Uuid
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extractedText   String   @db.Text
  confidenceScore Float    @default(0.95)
  keywords        Json?
  status          String   @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  processedAt     DateTime @default(now())

  @@map("ocr_results")
}

model DigitalAsset {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @db.Uuid
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  assetType    String   // IMAGE, PDF, VIDEO, AUDIO, CAD, ARCHIVE
  width        Int?
  height       Int?
  durationSec  Int?
  thumbnailUrl String?
  format       String
  createdAt    DateTime @default(now())

  @@map("digital_assets")
}

